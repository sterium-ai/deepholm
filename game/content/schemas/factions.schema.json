{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["factions"],
  "properties": {
    "factions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "relations", "rules"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "relations": {
            "type": "object",
            "additionalProperties": {"type": "string", "enum": ["hostile", "neutral", "friendly"]}
          },
          "rules": {
            "type": "object",
            "required": ["may_pass_doors", "may_reserve_colony_items", "may_be_ordered"],
            "properties": {
              "may_pass_doors": {"type": "boolean"},
              "may_reserve_colony_items": {"type": "boolean"},
              "may_be_ordered": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
