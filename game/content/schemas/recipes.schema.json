{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Workbench recipes (F2, ADR 061). A recipe is crafted at an object of kind `bench` from its `inputs` (hauled to the bench by craft_fetch jobs) by one craft_work job, and leaves its `outputs` on a tile next to the bench. Item ids and the bench kind are cross-checked by ContentRegistry (dangling_reference); it also rejects an item listed twice in one recipe's inputs or outputs and enforces the quantity maximum (RecipeBook.MAX_COUNT, the save's cap), as schema_violation.",
  "type": "object",
  "required": [
    "recipes"
  ],
  "properties": {
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "bench",
          "inputs",
          "outputs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "bench": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "item",
                "quantity"
              ],
              "properties": {
                "item": {
                  "type": "string",
                  "minLength": 1
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 999
                }
              },
              "additionalProperties": false
            }
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "item",
                "quantity"
              ],
              "properties": {
                "item": {
                  "type": "string",
                  "minLength": 1
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 999
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
