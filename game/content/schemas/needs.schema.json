{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["needs"],
  "properties": {
    "needs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "rate_per_day", "warn", "urgent", "critical", "restore", "source_kind", "full", "job_priority", "retry_base_ticks", "retry_cap_ticks"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "rate_per_day": {"type": "integer", "minimum": 0},
          "warn": {"type": "integer", "minimum": 0},
          "urgent": {"type": "integer", "minimum": 0},
          "critical": {"type": "integer", "minimum": 0},
          "restore": {"type": "integer", "minimum": 1},
          "source_kind": {"type": "string", "minLength": 1},
          "full": {"type": "integer", "minimum": 1},
          "job_priority": {"type": "integer", "minimum": 0},
          "retry_base_ticks": {"type": "integer", "minimum": 1},
          "retry_cap_ticks": {"type": "integer", "minimum": 1},
          "bedroom_rest_multiplier": {"type": "number", "exclusiveMinimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
