{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["jobs"],
  "properties": {
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "labour", "toils"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "labour": {"type": "string"},
          "toils": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "needs_tool": {"type": "string", "minLength": 1},
          "work_ticks": {"type": "integer", "minimum": 1},
          "priority": {"type": "integer", "minimum": 0},
          "retry_base_ticks": {"type": "integer", "minimum": 1},
          "retry_cap_ticks": {"type": "integer", "minimum": 1},
          "effects": {
            "type": "object",
            "properties": {
              "requires_tile": {"type": "string", "minLength": 1},
              "consumes": {"type": "string", "minLength": 1},
              "set_tile": {"type": "string", "minLength": 1},
              "clear_object": {"type": "boolean"},
              "yields": {
                "type": "object",
                "required": ["placement"],
                "properties": {
                  "placement": {"type": "string", "enum": ["target", "adjacent"]},
                  "always": {
                    "type": "array",
                    "items": {"type": "string", "minLength": 1}
                  },
                  "ground_berries": {"type": "integer", "minimum": 1},
                  "find_table": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["item", "weight"],
                      "properties": {
                        "item": {"type": ["string", "null"], "minLength": 1},
                        "weight": {"type": "integer", "minimum": 0}
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
