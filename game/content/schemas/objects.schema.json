{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["objects"],
  "properties": {
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "passable", "move_cost", "is_door", "footprint", "rotatable", "build_ticks", "max_builders", "build_cost"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "passable": {"type": "boolean"},
          "move_cost": {"type": "integer", "minimum": 0},
          "is_door": {"type": "boolean"},
          "health": {"type": "integer", "minimum": 0},
          "max_health": {"type": "integer", "minimum": 1},
          "footprint": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "integer", "minimum": 1}
          },
          "rotatable": {"type": "boolean"},
          "build_ticks": {"type": "integer", "minimum": 0},
          "max_builders": {"type": "integer", "minimum": 1},
          "build_cost": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "required": ["item", "quantity"],
              "properties": {
                "item": {"type": "string", "minLength": 1},
                "quantity": {"type": "integer", "minimum": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
