{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["scenarios"],
  "properties": {
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "tick_rate", "incidents_enabled", "setup"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1, "description": "A data/text key (for example \"scenario.new_game\"), never player text: the New Game dialog resolves it through TextTable (ADR 052, the localisation ADR)."},
          "seed": {"type": "integer"},
          "map": {
            "type": "object",
            "required": ["width", "height"],
            "properties": {
              "width": {"type": "integer", "minimum": 1},
              "height": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          },
          "tick_rate": {"type": "integer", "minimum": 1},
          "incidents_enabled": {"type": "boolean"},
          "setup": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["step"],
              "properties": {
                "step": {"type": "string", "enum": ["needed_tools", "per_colonist_objects", "object_rows", "dig_orders", "till_plot", "ground_items"]},
                "when": {"type": "string", "enum": ["scenario_seed"]},
                "kind": {"type": "string", "minLength": 1},
                "count": {"type": "integer", "minimum": 1},
                "seed_offset": {"type": "integer"},
                "priority": {"type": "integer", "minimum": 0},
                "search_radius": {"type": "integer", "minimum": 0},
                "tick_budget": {"type": "integer", "minimum": 1},
                "rows": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["name", "anchor", "offset", "objects"],
                    "properties": {
                      "name": {"type": "string", "minLength": 1},
                      "anchor": {"type": "string", "enum": ["clearing_top", "clearing_bottom"]},
                      "offset": {"type": "integer"},
                      "door": {"type": "string", "minLength": 1},
                      "objects": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "required": ["kind", "count"],
                          "properties": {
                            "kind": {"type": "string", "minLength": 1},
                            "count": {"type": "integer", "minimum": 1}
                          },
                          "additionalProperties": false
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
