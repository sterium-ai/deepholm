{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "rock_vein_count", "rock_vein_min_length", "rock_vein_max_length",
    "hazard_count", "hazard_placement_attempts",
    "tree_count", "tree_placement_attempts",
    "water_count", "water_placement_attempts",
    "spawn_area_x", "spawn_area_y", "spawn_area_width", "spawn_area_height",
    "colonist_count"
  ],
  "properties": {
    "rock_vein_count": {"type": "integer", "minimum": 0},
    "rock_vein_min_length": {"type": "integer", "minimum": 1},
    "rock_vein_max_length": {"type": "integer", "minimum": 1},
    "outcrop_count": {"type": "integer", "minimum": 0},
    "outcrop_min_size": {"type": "integer", "minimum": 1},
    "outcrop_max_size": {"type": "integer", "minimum": 1},
    "outcrop_placement_attempts": {"type": "integer", "minimum": 0},
    "outcrop_compactness": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "0..1 bias applied on every growth step while an outcrop blob is extended one 4-connected soil tile at a time: at 1.0 every extension grows from the most-recently-added (newest frontier) tile, producing a single elongated tendril; at 0.0 every extension picks a uniformly random tile already in the blob, producing a rounder, more isotropic cluster. Values in between mix the two sources per step. Purely a growth-shape knob -- it never changes outcrop_count/outcrop_min_size/outcrop_max_size/outcrop_placement_attempts."
    },
    "hazard_count": {"type": "integer", "minimum": 0},
    "hazard_placement_attempts": {"type": "integer", "minimum": 0},
    "tree_count": {"type": "integer", "minimum": 0},
    "tree_placement_attempts": {"type": "integer", "minimum": 0},
    "water_count": {"type": "integer", "minimum": 0},
    "water_placement_attempts": {"type": "integer", "minimum": 0},
    "spawn_area_x": {"type": "integer", "minimum": 0},
    "spawn_area_y": {"type": "integer", "minimum": 0},
    "spawn_area_width": {"type": "integer", "minimum": 1},
    "spawn_area_height": {"type": "integer", "minimum": 1},
    "colonist_count": {"type": "integer", "minimum": 0},
    "reference_width": {"type": "integer", "minimum": 1},
    "reference_height": {"type": "integer", "minimum": 1},
    "default_new_game_width": {"type": "integer", "minimum": 1},
    "default_new_game_height": {"type": "integer", "minimum": 1},
    "min_world_size": {"type": "integer", "minimum": 1},
    "max_world_size": {"type": "integer", "minimum": 1},
    "tree_grove_count": {"type": "integer", "minimum": 0},
    "tree_grove_radius": {"type": "integer", "minimum": 1},
    "berry_bush_count": {"type": "integer", "minimum": 0},
    "berry_bush_placement_attempts": {"type": "integer", "minimum": 0},
    "berry_bush_grove_count": {"type": "integer", "minimum": 0},
    "berry_bush_grove_radius": {"type": "integer", "minimum": 1},
    "river_min_width": {"type": "integer", "minimum": 1},
    "river_max_width": {"type": "integer", "minimum": 1},
    "river_control_point_spacing": {"type": "integer", "minimum": 1},
    "river_max_transversal_delta": {"type": "integer", "minimum": 0},
    "spawn_search_attempts": {"type": "integer", "minimum": 1},
    "spawn_water_step_limit": {"type": "integer", "minimum": 0},
    "spawn_food_step_limit": {"type": "integer", "minimum": 0},
    "spawn_tree_step_limit": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
