{
  "model": "opus",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git grep:*)",
      "Bash(git ls-files:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(powershell:*)",
      "Bash(pwsh:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "enabledPlugins": {
    "brand-voice@synced": false,
    "canva@synced": false,
    "discord@synced": false,
    "engineering@synced": false,
    "marketing@synced": false,
    "productivity@synced": false,
    "sales@synced": false,
    "postiz@synced": false,
    "searchfit-seo@synced": false,
    "brightdata-plugin@synced": false,
    "video-to-code-skill@synced": false
  }
}
